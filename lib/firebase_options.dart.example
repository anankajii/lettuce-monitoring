import 'package:firebase_core/firebase_core.dart' show FirebaseOptions;
import 'package:flutter/foundation.dart' show defaultTargetPlatform, TargetPlatform;

/// INSTRUKSI SETUP:
/// 1. Copy file ini menjadi: lib/firebase_options.dart
/// 2. Isi nilai-nilai dari google-services.json & Firebase Console:
///    - apiKey: dari android/app/google-services.json → api_key.current_key
///    - appId: dari google-services.json → mobilesdk_app_id
///    - messagingSenderId: dari google-services.json → project_number
///    - projectId: nama project Firebase
///    - databaseURL: dari Realtime Database
///    - storageBucket: dari Firebase Storage
/// 3. Jangan commit file ini ke git (sudah di .gitignore)

class DefaultFirebaseOptions {
  static FirebaseOptions get currentPlatform {
    if (defaultTargetPlatform == TargetPlatform.android) {
      return android;
    }
    if (defaultTargetPlatform == TargetPlatform.iOS) {
      return ios;
    }
    if (defaultTargetPlatform == TargetPlatform.windows) {
      return windows;
    }
    throw UnsupportedError(
      'DefaultFirebaseOptions tidak tersedia untuk platform ini.',
    );
  }

  static const FirebaseOptions android = FirebaseOptions(
    apiKey: 'YOUR_API_KEY_HERE',
    appId: 'YOUR_APP_ID_HERE',
    messagingSenderId: 'YOUR_MESSAGING_SENDER_ID_HERE',
    projectId: 'lettuce-monitoring-165fd',
    databaseURL: 'https://lettuce-monitoring-165fd-default-rtdb.firebaseio.com',
    storageBucket: 'lettuce-monitoring-165fd.appspot.com',
  );

  static const FirebaseOptions ios = FirebaseOptions(
    apiKey: 'YOUR_API_KEY_HERE',
    appId: 'YOUR_APP_ID_HERE',
    messagingSenderId: 'YOUR_MESSAGING_SENDER_ID_HERE',
    projectId: 'lettuce-monitoring-165fd',
    databaseURL: 'https://lettuce-monitoring-165fd-default-rtdb.firebaseio.com',
    storageBucket: 'lettuce-monitoring-165fd.appspot.com',
    iosBundleId: 'com.example.mobile',
  );

  static const FirebaseOptions windows = FirebaseOptions(
    apiKey: 'YOUR_API_KEY_HERE',
    appId: 'YOUR_APP_ID_HERE',
    messagingSenderId: 'YOUR_MESSAGING_SENDER_ID_HERE',
    projectId: 'lettuce-monitoring-165fd',
    databaseURL: 'https://lettuce-monitoring-165fd-default-rtdb.firebaseio.com',
    storageBucket: 'lettuce-monitoring-165fd.appspot.com',
  );
}
